# Cấu hình Cơ sở dữ liệu (ví dụ)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<db>

# Cấu hình Bảo mật mã hóa JWT
# Mẹo tạo chuỗi bí mật ngẫu nhiên bảo mật cao: Chạy lệnh `openssl rand -hex 32` trên terminal
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình hệ thống đường dẫn lưu trữ hình ảnh
UPLOAD_DIR=static/uploads

# Cấu hình lưu trữ MinIO (tùy chọn)
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dermscreen
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
